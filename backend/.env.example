# 백엔드 비밀값 템플릿. backend/.env로 복사 후 값 채울 것.
# backend/.env는 .gitignore로 추적되지 않음.

# KIS (한국투자증권 모의투자)
KIS_APP_KEY=
KIS_APP_SECRET=

# JWT (HS256, 32바이트 이상 무작위 값)
JWT_SECRET=

# 초기 관리자 (1회 시드용. 시드 후 비워둘 것)
ADMIN_INITIAL_EMAIL=admin@simulator.local
ADMIN_INITIAL_USERNAME=Administrator
ADMIN_INITIAL_PASSWORD=

# Finnhub (D14)
FINNHUB_API_KEY=

# Claude API (D36)
CLAUDE_API_KEY=

# 로컬 DB (Docker Compose 기본값과 동일하게 유지)
DB_USERNAME=simulator
DB_PASSWORD=simulator
