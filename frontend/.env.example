# 프론트엔드 환경변수 (Vite는 VITE_ 프리픽스만 빌드에 포함)
# 로컬:  cp .env.example .env.local 후 값 채우기
# Vercel: Project Settings → Environment Variables 에 등록 (Production / Preview / Development)

# 백엔드 API base URL
#  - 로컬:  http://localhost:8080
#  - 운영:  https://mockvibe.duckdns.org
#
# 이 값에서 WebSocket URL도 자동 파생됩니다:
#   http  → ws  + /ws
#   https → wss + /ws
# (frontend/src/hooks/useStompPrice.ts 참조)
VITE_API_BASE_URL=http://localhost:8080
