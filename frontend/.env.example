# 프론트엔드 환경변수 (Vite는 VITE_ 프리픽스만 빌드에 포함)
# 로컬: cp .env.example .env.local 후 값 채우기
# Vercel: Project Settings → Environment Variables 에 등록

# 백엔드 API base URL
# - 로컬:    http://localhost:8080
# - 운영:    https://mockvibe.duckdns.org  (또는 본인 도메인)
VITE_API_BASE_URL=http://localhost:8080

# STOMP WebSocket endpoint
# - 로컬:    ws://localhost:8080/ws
# - 운영:    wss://mockvibe.duckdns.org/ws
VITE_WS_URL=ws://localhost:8080/ws
