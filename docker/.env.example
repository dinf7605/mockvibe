# docker-compose.yml에서 사용하는 환경 변수
# 실제 사용 시 docker/.env로 복사 후 값 채워서 사용

ORACLE_SYS_PASSWORD=OraclePwd123!
DB_USERNAME=simulator
DB_PASSWORD=simulator

# 백엔드 컨테이너 (app 서비스) — 풀스택 기동 시 필수
JWT_SECRET=dev-only-change-me-with-32byte-random-value-please

# 초기 관리자 1회 시드 (이미 DB에 있으면 무시됨)
ADMIN_INITIAL_EMAIL=admin@simulator.local
ADMIN_INITIAL_USERNAME=Administrator
ADMIN_INITIAL_PASSWORD=AdminPwd123!

# 외부 API 키 (미설정 시 해당 기능 비활성)
KIS_APP_KEY=
KIS_APP_SECRET=
FINNHUB_API_KEY=
GEMINI_API_KEY=
