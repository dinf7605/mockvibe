# ============================================================================
# MockVibe — Nginx 리버스 프록시 (HTTPS + WebSocket)
#
# 환경변수 치환: deploy/scripts/deploy.sh 가 본 template 의 두 토큰
# (도메인 / 프론트 URL) 을 .env.prod 값으로 sed 치환한 뒤 conf.d/mockvibe.conf
# 로 출력. compose 가 그 결과 파일을 nginx 컨테이너에 마운트한다.
# ============================================================================

# upstream — compose 네트워크 내부 서비스명
upstream mockvibe_backend {
    server app:8080;
    keepalive 32;
}

# WebSocket 업그레이드를 위한 map
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ----------------------------------------------------------------------------
# HTTP — Let's Encrypt 챌린지 통과 + HTTPS 리다이렉트
# ----------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name APP_DOMAIN_PLACEHOLDER;

    # certbot --webroot 챌린지 (이게 작동해야 인증서 발급/갱신 가능)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 헬스체크 (nginx 자체)
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # 그 외 전부 HTTPS로 리다이렉트
    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------------------------------------------------------------
# HTTPS — 실제 서비스
# ----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name APP_DOMAIN_PLACEHOLDER;

    # Let's Encrypt 인증서 경로 (compose 볼륨)
    ssl_certificate     /etc/letsencrypt/live/APP_DOMAIN_PLACEHOLDER/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/APP_DOMAIN_PLACEHOLDER/privkey.pem;

    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    # 파일 업로드/응답 크기 (기본 1MB는 일부 응답에서 부족)
    client_max_body_size 10m;

    # ========================================================================
    # 모든 location의 upstream 호출 default
    # - HTTP/1.1: Tomcat 10.1 이상은 1.0 요청을 strict하게 거부할 수 있다
    # - Connection "": keepalive upstream을 위해 hop-by-hop Connection 헤더 제거
    # - Host: backend가 Spring forward-headers-strategy=framework로 해석
    # ========================================================================
    proxy_http_version 1.1;
    proxy_set_header   Connection        "";
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;

    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    # ------------------------------------------------------------------------
    # WebSocket (STOMP)
    # ⚠️ nginx 규칙: 한 location에 proxy_set_header가 하나라도 있으면 server
    # 블록 default proxy_set_header가 전부 상속되지 않는다. WebSocket 전용
    # Upgrade/Connection 명시 때문에 Host/X-Forwarded-* 까지 모두 다시 명시.
    # ------------------------------------------------------------------------
    location /ws {
        proxy_pass http://mockvibe_backend/ws;
        proxy_http_version 1.1;

        # server 블록 default 헤더 복제 (상속 안 됨)
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 전용
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 장기 연결 — heartbeat 15s 보다 넉넉히
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
    }

    # ------------------------------------------------------------------------
    # actuator — 헬스체크만 외부 허용, 그 외(metrics, prometheus)는 사설망/Basic Auth 권장
    # ------------------------------------------------------------------------
    location = /actuator/health {
        proxy_pass http://mockvibe_backend/actuator/health;
        access_log off;
    }
    location /actuator/ {
        # 운영에서는 사설망/VPN IP만 허용
        # allow 10.0.0.0/8;
        # deny all;
        proxy_pass http://mockvibe_backend/actuator/;
    }

    # ------------------------------------------------------------------------
    # Swagger UI / OpenAPI — 데모 편의용 공개
    # ------------------------------------------------------------------------
    location /swagger-ui {
        proxy_pass http://mockvibe_backend/swagger-ui;
    }
    location /v3/api-docs {
        proxy_pass http://mockvibe_backend/v3/api-docs;
    }

    # ------------------------------------------------------------------------
    # 기본
    # ------------------------------------------------------------------------
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # 루트(/)만 exact match로 frontend redirect — preflight·실제 API path는 catch-all로
    location = / {
        return 302 ${FRONTEND_URL_PLACEHOLDER};
    }

    # 그 외 모든 경로 — backend로 catch-all 프록시
    # backend의 컨트롤러는 /auth, /portfolio, /trades, /stocks, /backtest, /risk,
    # /orders, /admin, /history, /ai 등 /api prefix 없이 직접 매핑되어 있음.
    # 더 구체적인 location(/actuator, /swagger-ui, /v3/api-docs, /ws)이 우선 매칭됨.
    location / {
        proxy_pass http://mockvibe_backend;
    }
}
